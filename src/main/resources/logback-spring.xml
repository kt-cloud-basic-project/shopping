<?xml version="1.0" encoding="UTF-8" ?>
<configuration>
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %magenta(%-4relative) --- [ %thread{10} ] %cyan(%logger{20}) : %msg%n"/>
    <springProperty name="LOGSTASH_HOST" source="logstash.host" defaultValue="localhost"/>   <!-- 🔁 실제 호스트로 변경 -->
    <springProperty name="LOGSTASH_PORT" source="logstash.port" defaultValue="9601"/>            <!-- 🔁 실제 포트로 변경 -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>${LOGSTASH_HOST}:${LOGSTASH_PORT}</destination>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        <customFields>
            {"app":"${APP_NAME}","env":"${spring.profiles.active}"}
        </customFields>
    </appender>

<!--    <springProfile name="local">-->
<!--        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">-->
<!--            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">-->
<!--                <pattern>${CONSOLE_LOG_PATTERN}</pattern>-->
<!--            </encoder>-->
<!--        </appender>-->
<!--    </springProfile>-->

    <root level="INFO">
        <appender-ref ref="LOGSTASH"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>